# GEMINI_API_KEY: Optional. Google Gemini API key for server-side AI color analysis.
# If not provided, the app checks for OPENROUTER_API_KEY, then falls back to client-side pixel sampling.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OPENROUTER_API_KEY: Optional. OpenRouter API key for server-side AI color analysis.
# Used as fallback if GEMINI_API_KEY is not set. Both can be configured simultaneously.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
